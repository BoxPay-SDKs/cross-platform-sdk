    <string name="payment_attempt_limit_reached_desc">அதிகபட்ச கட்டண முயற்சிகள் எட்டப்பட்டன. வணிகரின் இணையதளத்திற்குத் திரும்பிச் சென்று புதிய கட்டணத்தைத் தொடங்கவும்.</string>
    <string name="exit_checkout_desc">உங்கள் கட்டணம் இன்னும் முடிக்கப்படவில்லை. இப்போது வெளியேறினால், உங்கள் முன்னேற்றம் இழக்கப்படும்.</string>
    <string name="rbi_guidelines_desc">புதிய RBI வழிகாட்டுதல்களின்படி, உங்கள் கார்டு தகவலை இனி எங்களுடன் சேமிக்க முடியாது.</string>
    <string name="enter_otp_desc">உங்கள் பதிவு செய்யப்பட்ட மொபைல் எண்ணுக்கு அனுப்பப்பட்ட ஒரு முறை கடவுச்சொல்லை உள்ளிடவும்.</string>
    <string name="qr_code_save_complete_desc">QR குறியீடு உங்கள் பதிவிறக்கங்கள் கோப்புறையில் சேமிக்கப்பட்டது.</string>
    <string name="qr_code_save_failed_desc">QR குறியீட்டை சேமிக்க முடியவில்லை. உங்கள் சேமிப்பக அனுமதிகளைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்.</string>
    <string name="unable_to_remove_card_desc">ஒரு சிக்கல் காரணமாக உங்கள் சேமிக்கப்பட்ட கார்டை அகற்ற முடியவில்லை. உங்கள் கார்டு இன்னும் சேமிக்கப்பட்டுள்ளது.</string>
    <string name="retrying_your_payment_securely_desc">கட்டணம் தோல்வியடைந்தது. வேறொரு கட்டண பங்குதாரருடன் மீண்டும் முயற்சிக்கிறோம். OTP மீண்டும் தேவைப்படலாம்.</string>
    <string name="payment_method_retry_limit_reached_desc">இந்த கட்டண முறைக்கான அதிகபட்ச கட்டண முயற்சிகளை நீங்கள் எட்டிவிட்டீர்கள். தொடர வேறு கட்டண முறையைத் தேர்ந்தெடுக்கவும்</string>
    <string name="payment_expired_desc">உங்கள் பாதுகாப்பிற்காக, செயலற்ற தன்மையால் உங்கள் அமர்வு காலாவதியாகிவிட்டது. கட்டண செயல்முறையை மீண்டும் தொடங்கவும்.</string>
    <string name="pay_instruction_desc_1">QR குறியீட்டை பதிவிறக்கி மற்றொரு சாதனத்தில் திறக்கவும். உங்கள் மொபைலில் வங்கி ஆப்பைத் திறந்து, கட்டணம் செலுத்த QR குறியீட்டை ஸ்கேன் செய்யவும்.</string>
    <string name="pay_instruction_num_1">1.</string>
    <string name="pay_instruction_num_2">2.</string>
    <string name="pay_instruction_num_3">3.</string>
    <string name="pay_instruction_num_4">4.</string>
    <string name="pay_instruction_desc_2">கட்டண திரையில் காட்டப்படும் பெறுநருக்கு உங்கள் கட்டணம் செலுத்தப்படும்.</string>
    <string name="pay_instruction_desc_3">கட்டணம் செயல்படுத்தப்பட 2 நிமிடங்கள் வரை ஆகலாம் என்பதால், இந்த சாளரத்தை மூடவோ புதுப்பிக்கவோ வேண்டாம்.</string>
    <string name="pay_instruction_desc_4">கட்டண செயல்முறை முடிந்தவுடன் நீங்கள் வணிகரிடம் திரும்ப அழைத்துச் செல்லப்படுவீர்கள்.</string>
    <string name="cancel_payment_desc">இந்த கட்டணத்தை ரத்து செய்ய விரும்புகிறீர்களா?</string>

