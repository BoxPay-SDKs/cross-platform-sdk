    <!--    Bottom Sheet Description-->
    <string name="payment_attempt_limit_reached_desc">भुगतान प्रयासों की अधिकतम संख्या पूरी हो गई है। कृपया व्यापारी की वेबसाइट पर वापस जाएं और नया भुगतान शुरू करें।</string>
    <string name="exit_checkout_desc">आपका भुगतान अभी पूरा नहीं हुआ है। अगर आप अभी बाहर निकलते हैं, तो आपकी प्रगति खो जाएगी।</string>
    <string name="rbi_guidelines_desc">नए RBI दिशानिर्देशों के अनुसार, अब हम आपके कार्ड की जानकारी को अपने पास सहेज नहीं सकते।</string>
    <string name="enter_otp_desc">अपने पंजीकृत मोबाइल नंबर पर भेजा गया वन-टाइम पासवर्ड दर्ज करें।</string>
    <string name="qr_code_save_complete_desc">QR कोड आपके डाउनलोड फ़ोल्डर में सहेजा गया।</string>
    <string name="qr_code_save_failed_desc">हम QR कोड सहेज नहीं सके। कृपया अपनी स्टोरेज अनुमतियां जांचें और फिर से प्रयास करें।</string>
    <string name="unable_to_remove_card_desc">किसी समस्या के कारण हम आपका सहेजा गया कार्ड नहीं हटा सके। आपका कार्ड अब भी सहेजा हुआ है।</string>
    <string name="retrying_your_payment_securely_desc">भुगतान विफल हुआ। किसी अन्य भुगतान पार्टनर के साथ फिर से प्रयास किया जा रहा है। OTP फिर से आवश्यक हो सकता है।</string>
    <string name="payment_method_retry_limit_reached_desc">आपने इस भुगतान विधि के लिए भुगतान प्रयासों की अधिकतम संख्या पूरी कर ली है। जारी रखने के लिए कृपया कोई अन्य भुगतान विधि चुनें</string>
    <string name="payment_expired_desc">आपकी सुरक्षा के लिए, निष्क्रियता के कारण आपका सत्र समाप्त हो गया है। कृपया भुगतान प्रक्रिया फिर से शुरू करें।</string>
    <string name="pay_instruction_desc_1">QR कोड डाउनलोड करें और इसे किसी अन्य डिवाइस पर खोलें। अपने मोबाइल पर बैंकिंग ऐप खोलें और भुगतान करने के लिए QR कोड स्कैन करें।</string>
    <string name="pay_instruction_num_1">1.</string>
    <string name="pay_instruction_num_2">2.</string>
    <string name="pay_instruction_num_3">3.</string>
    <string name="pay_instruction_num_4">4.</string>
    <string name="pay_instruction_desc_2">आपका भुगतान भुगतान स्क्रीन पर दिखाए गए प्राप्तकर्ता को किया जाएगा।</string>
    <string name="pay_instruction_desc_3">इस विंडो को बंद या रीफ्रेश न करें, क्योंकि भुगतान प्रोसेस होने में 2 मिनट तक लग सकते हैं।</string>
    <string name="pay_instruction_desc_4">भुगतान प्रक्रिया पूरी होने के बाद आपको व्यापारी के पास वापस भेज दिया जाएगा।</string>
