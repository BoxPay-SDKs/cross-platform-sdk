    <!--    Bottom Sheet Description-->
    <string name="payment_attempt_limit_reached_desc">Đã đạt số lần thử thanh toán tối đa. Vui lòng quay lại trang web của người bán và bắt đầu thanh toán mới.</string>
    <string name="exit_checkout_desc">Thanh toán của bạn chưa hoàn tất. Nếu thoát ngay bây giờ, tiến trình của bạn sẽ bị mất.</string>
    <string name="rbi_guidelines_desc">Theo hướng dẫn mới của RBI, chúng tôi không còn có thể lưu trữ thông tin thẻ của bạn.</string>
    <string name="enter_otp_desc">Nhập mật khẩu dùng một lần được gửi đến số điện thoại di động đã đăng ký của bạn.</string>
    <string name="qr_code_save_complete_desc">Mã QR đã được lưu vào thư mục Tải xuống của bạn.</string>
    <string name="qr_code_save_failed_desc">Chúng tôi không thể lưu mã QR. Vui lòng kiểm tra quyền lưu trữ và thử lại.</string>
    <string name="unable_to_remove_card_desc">Chúng tôi không thể xóa thẻ đã lưu của bạn do gặp sự cố. Thẻ của bạn vẫn được lưu.</string>
    <string name="retrying_your_payment_securely_desc">Thanh toán thất bại. Đang thử lại với đối tác thanh toán khác. Có thể cần nhập lại OTP.</string>
    <string name="payment_method_retry_limit_reached_desc">Bạn đã đạt số lần thử thanh toán tối đa cho phương thức này. Vui lòng chọn phương thức thanh toán khác để tiếp tục</string>
    <string name="payment_expired_desc">Vì lý do bảo mật, phiên của bạn đã hết hạn do không hoạt động. Vui lòng bắt đầu lại quy trình thanh toán.</string>
    <string name="pay_instruction_desc_1">Tải mã QR xuống và mở trên thiết bị khác. Khởi chạy ứng dụng ngân hàng trên điện thoại của bạn và quét mã QR để thanh toán.</string>
    <string name="pay_instruction_num_1">1.</string>
    <string name="pay_instruction_num_2">2.</string>
    <string name="pay_instruction_num_3">3.</string>
    <string name="pay_instruction_num_4">4.</string>
    <string name="pay_instruction_desc_2">Khoản thanh toán của bạn sẽ được chuyển đến người nhận hiển thị trên màn hình thanh toán.</string>
    <string name="pay_instruction_desc_3">Không đóng hoặc làm mới cửa sổ này vì có thể mất đến 2 phút để xử lý thanh toán.</string>
    <string name="pay_instruction_desc_4">Bạn sẽ được đưa trở lại trang của người bán sau khi hoàn tất quy trình thanh toán.</string>
    <string name="cancel_payment_desc">Bạn có chắc chắn muốn hủy thanh toán này không?</string>

