<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-sdk tools:overrideLibrary="com.revolut.revolutpay, com.revolut.revolutpayments, com.google.android.gms.wallet,
        androidx.compose.ui, androidx.compose.ui.test, androidx.compose.ui.test.junit4, androidx.compose.ui.test.manifest,
        androidx.compose.ui.util, androidx.compose.ui.unit, androidx.compose.ui.text, androidx.compose.ui.geometry,
        androidx.compose.ui.graphics, androidx.compose.ui.tooling, androidx.compose.ui.tooling.preview,
        androidx.compose.ui.tooling.data, androidx.compose.ui.viewbinding, androidx.compose.ui.inspection,
        androidx.compose.material, androidx.compose.material3, androidx.compose.material.ripple,
        androidx.compose.material.icons.core, androidx.compose.material.icons.extended,
        androidx.compose.material3.adaptive, androidx.compose.material3.adaptive.layout, androidx.compose.material3.adaptive.navigation,
        androidx.compose.foundation, androidx.compose.foundation.layout,
        androidx.compose.runtime, androidx.compose.runtime.livedata, androidx.compose.runtime.saveable, androidx.compose.runtime.tracing,
        androidx.compose.animation, androidx.compose.animation.core, androidx.compose.animation.graphics,
        androidx.activity, androidx.activity.compose,
        androidx.lifecycle, androidx.lifecycle.runtime.compose, androidx.lifecycle.viewmodel.compose,
        androidx.camera.core, androidx.camera.camera2, androidx.camera.lifecycle, androidx.camera.view" />
    <queries>
        <!-- Example Store and Services (existing entries) -->
        <package android:name="com.example.store" />
        <package android:name="com.example.services" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tez" />                    <!-- GPay -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="gpay" />                    <!-- GPay -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="phonepe" />                <!-- PhonePe -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="paytmmp" />                <!-- Paytm -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bhim" />                   <!-- BHIM -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amazon" />                 <!-- Amazon Pay -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amazonmandate" />          <!-- Amazon Pay mandate -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="jupiter" />                <!-- Jupiter -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="postpe" />                 <!-- BharatPe -->
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mobikwik" />                <!-- MobiKwik -->
        </intent>

        <!-- GPay -->
        <package android:name="com.google.android.apps.nbu.paisa.user" />

        <!-- PhonePe -->
        <package android:name="com.phonepe.app" />

        <!-- Paytm -->
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />                     <!-- BHIM -->
        <package android:name="in.amazon.mShop.android.shopping" />      <!-- Amazon Pay -->

        <package android:name="com.mobikwik_new" />        <!-- MobiKwik -->
        <package android:name="com.postpe.app" />          <!-- BharatPe (consumer UPI) -->
        <!-- <package android:name="com.bharatpe.app" /> --> <!-- BharatPe for Business (optional) -->
        <package android:name="money.jupiter" />           <!-- Jupiter -->
        <package android:name="com.popclub.android" />     <!-- POP UPI -->
    </queries>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- NFC card scan — declared as not required so the SDK works on devices without NFC -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <application>
        <activity
            android:name="com.crossplatform.BoxPayActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />
    </application>
</manifest>